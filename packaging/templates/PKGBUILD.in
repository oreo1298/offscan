# Maintainer: @MAINTAINER@
# Generated by packaging/build.py from packaging/templates/PKGBUILD.in; edit those, not this file.
# The vendored wheels (yara-x, regipy and its dependencies) are not packaged by
# Arch; they are pinned by SHA-256 in packaging/vendor.lock.json.

pkgname=@NAME@
pkgver=@PKGVER@
pkgrel=1
pkgdesc='@SUMMARY@'
arch=('x86_64' 'aarch64')
url='@HOMEPAGE@'
license=('@LICENSE@')
depends=(@DEPENDS@)
optdepends=(@OPTDEPENDS@)
makedepends=('python')
options=('!strip' '!debug')
install=@NAME@.install
source=(@SOURCES@)
source_x86_64=(@SOURCES_X86_64@)
source_aarch64=(@SOURCES_AARCH64@)
noextract=(@NOEXTRACT@)
sha256sums=(@SHA256SUMS@)
sha256sums_x86_64=(@SHA256SUMS_X86_64@)
sha256sums_aarch64=(@SHA256SUMS_AARCH64@)

package() {
    cd "$srcdir/@SRCDIR@"
    python -I packaging/build.py stage --flavor arch --arch "$CARCH" --wheels "$srcdir" --dest "$pkgdir"
}
